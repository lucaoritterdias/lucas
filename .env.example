# Contact form (/api/contact) — copy to .env.local and fill in.
# Without SMTP_HOST, SMTP_USER and SMTP_PASS the form shows an error with email/WhatsApp links instead of sending.

# SMTP server of the mailbox that sends the notifications
# Google Workspace: smtp.gmail.com, port 465, and an App Password (not the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=lucas@polvor.com
SMTP_PASS=

# Optional: sender shown in the inbox (defaults to "Site Lucas Ritter Dias" <SMTP_USER>)
# SMTP_FROM="Site Lucas Ritter Dias <lucas@polvor.com>"

# Optional: where messages are delivered (defaults to lucas@polvor.com)
# CONTACT_TO=lucas@polvor.com
